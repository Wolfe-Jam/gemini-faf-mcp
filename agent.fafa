version: "1.0"
agent:
  name: gemini-faf-mcp
  displayName: Gemini FAF
  id: urn:air:faf.one:agent:gemini-faf-mcp
  version: 3.1.0
  description: "Persistent project context for Google Gemini, from your IANA-registered project.faf."
  homepage: https://faf.one
capabilities:
  - name: faf_read
    type: tool
    description: Read project DNA from a .faf file
    tags:
      - faf_read
  - name: faf_validate
    type: tool
    description: Validate a .faf file and return score, tier and issues
    tags:
      - faf_validate
  - name: faf_score
    type: tool
    description: Score a .faf file on the always-33 engine
    tags:
      - faf_score
  - name: faf_discover
    type: tool
    description: Find the project.faf by walking up from a folder
    tags:
      - faf_discover
  - name: faf_init
    type: tool
    description: Create a starter project.faf (never overwrites)
    tags:
      - faf_init
  - name: faf_stringify
    type: tool
    description: Re-serialize a .faf file as clean YAML
    tags:
      - faf_stringify
  - name: faf_context
    type: tool
    description: Gemini-optimized context from a .faf file
    tags:
      - faf_context
  - name: faf_gemini
    type: tool
    description: Write GEMINI.md from project.faf, keeping your own text
    tags:
      - faf_gemini
  - name: faf_agents
    type: tool
    description: Write AGENTS.md from project.faf, keeping your own text
    tags:
      - faf_agents
  - name: faf_migrate
    type: tool
    description: Bring a .faf file to the current format version
    tags:
      - faf_migrate
  - name: faf_about
    type: tool
    description: FAF format and server info
    tags:
      - faf_about
  - name: faf_model
    type: tool
    description: A 100% Trophy example .faf for a project type
    tags:
      - faf_model
  - name: faf_auto
    type: tool
    description: Detect the stack from the repo and fill empty slots
    tags:
      - faf_auto
endpoints:
  - protocol: mcp
    transport: http
    location: https://mcpaas.live/gemini/mcp/v1
metadata:
  cards:
    domain: faf.one
    examples:
      - What's my project's AI-readiness score?
      - Write GEMINI.md from my project.faf
      - Fill my project.faf from this repo
