# gemini-faf-mcp — FAF Agent Card (.fafa)
# Generated from pyproject.toml + server.json. Capabilities = the live MCP tools (server.py).
# Provenance is the canonical FAF context block (one context, every door).

version: "0.1"
agent:
  name: gemini-faf-mcp
  id: did:web:faf.one:gemini-faf-mcp
  vendor: WolfeJAM
  version: 2.5.1
  description: Persistent Project Context for Google Gemini. IANA-registered .faf format, MCP server + Cloud Run REST API, unifies CLAUDE.md, GEMINI.md, AGENTS.md.
  homepage: https://faf.one
  license: MIT
capabilities:
  - name: faf_read
    type: tool
    description: Read project DNA from a .faf file. Returns the full parsed structure.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_validate
    type: tool
    description: Validate a .faf file and return score, tier, and issues.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_score
    type: tool
    description: Quick Mk4 score check — returns score (0-100%), tier, and slot counts.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_discover
    type: tool
    description: Find .faf files in the project tree by walking up from start_dir.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_init
    type: tool
    description: Create a starter .faf file with project name, goal, and language.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_stringify
    type: tool
    description: Convert parsed FAF data back to YAML string.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_context
    type: tool
    description: Get Gemini-optimized context from a .faf file.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_gemini
    type: tool
    description: Export and write GEMINI.md from a .faf file (non-destructive).
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_agents
    type: tool
    description: Export and write AGENTS.md from a .faf file (non-destructive).
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_about
    type: tool
    description: FAF format info — IANA registration, version, ecosystem.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_model
    type: tool
    description: Get a 100% Trophy-scored example .faf file for a specific project type.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
  - name: faf_auto
    type: tool
    description: Auto-detect project stack and generate/update a .faf file.
    cites_spec: application/vnd.faf+yaml
    tags:
      - faf
endpoints:
  - protocol: mcp
    version: 2025-06-18
    transport: stdio
    location: gemini-faf-mcp
  - protocol: mcp
    version: 2025-06-18
    transport: http
    location: https://mcpaas.live/gemini/mcp/v1
provenance:
  faf: ./project.faf
  mediaType: application/vnd.faf+yaml
  iana: https://www.iana.org/assignments/media-types/application/vnd.faf+yaml
  deterministic: true
  generated: 2026-08-20T00:00:00Z
metadata:
  repository: https://github.com/Wolfe-Jam/gemini-faf-mcp
  privacy: Runs locally. No telemetry, no analytics, no data leaves the machine.
  tool_tiers:
    status: flat
    model: 12 core tools, no tier split (smaller surface than the JS fleet — no fabricated split)
  trinity:
    context: ./project.faf (live)
    memory: none — no .fafm soul file in this repo
    agent: this card
